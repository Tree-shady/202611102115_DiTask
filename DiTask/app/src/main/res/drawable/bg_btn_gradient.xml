<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/btn_gradient_disabled" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="0"
                        android:endColor="@color/brand_green"
                        android:startColor="@color/brand_cyan"
                        android:type="linear" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
