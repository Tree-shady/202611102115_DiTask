<Window x:Class="TaskManager.PcClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务管理" Width="1100" Height="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F5F6F8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Username, StringFormat='当前用户：{0}'}"
                           VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
                <Button Content="新增任务" Margin="0,0,8,0" Padding="12,4" Command="{Binding AddTaskCommand}"/>
                <Button Content="编辑" Margin="0,0,8,0" Padding="12,4" Command="{Binding EditTaskCommand}"/>
                <Button Content="完成/重开" Margin="0,0,8,0" Padding="12,4" Command="{Binding ToggleCompleteCommand}"/>
                <Button Content="删除" Margin="0,0,8,0" Padding="12,4" Command="{Binding DeleteTaskCommand}"/>
                <Button Content="立即同步" Margin="0,0,8,0" Padding="12,4" Command="{Binding SyncCommand}"/>
                <Button Content="回收站" Margin="0,0,8,0" Padding="12,4" Command="{Binding OpenRecycleBinCommand}"/>
                <Button Content="退出登录" Padding="12,4" Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Border>

        <!-- 搜索栏 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,7">
                <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="220" Padding="6,4" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="状态" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox Width="90" Padding="5,3" SelectedIndex="{Binding StatusFilterIndex}">
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="待办"/>
                    <ComboBoxItem Content="进行中"/>
                    <ComboBoxItem Content="已完成"/>
                </ComboBox>
                <TextBlock Text="优先级" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox Width="90" Padding="5,3" SelectedIndex="{Binding PriorityFilterIndex}">
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="普通"/>
                    <ComboBoxItem Content="重要"/>
                    <ComboBoxItem Content="紧急"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F6F8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ConnectionStateText, StringFormat='网络：{0}'}" Foreground="#555555" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding PendingSyncCount, StringFormat='待同步：{0}'}" Foreground="#555555" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding LastSyncTimeText, StringFormat='上次同步：{0}'}" Foreground="#555555" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#555555" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 任务列表 -->
        <DataGrid ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" MouseDoubleClick="TaskGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                            <Setter Property="Background" Value="#FFF7E0"/>
                            <Setter Property="Foreground" Value="#795600"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Background" Value="#FFF0F0"/>
                            <Setter Property="Foreground" Value="#B00020"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="详情摘要" Binding="{Binding ContentSummary}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="状态" Width="80"
                                    Binding="{Binding Status, Converter={StaticResource StatusToText}}"/>
                <DataGridTextColumn Header="优先级" Width="80"
                                    Binding="{Binding Priority, Converter={StaticResource PriorityToText}}"/>
                <DataGridTextColumn Header="截止时间" Width="140"
                                    Binding="{Binding DueTime, Converter={StaticResource UtcToLocal}}"/>
                <DataGridTextColumn Header="更新时间" Width="140"
                                    Binding="{Binding UpdatedAt, Converter={StaticResource UtcToLocal}}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
