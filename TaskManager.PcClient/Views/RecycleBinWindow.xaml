<Window x:Class="TaskManager.PcClient.Views.RecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回收站" Width="850" Height="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F6F8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,8">
                <Button Content="恢复任务" Margin="0,0,8,0" Padding="12,4"
                        Command="{Binding RestoreTaskCommand}"/>
                <Button Content="从本机彻底删除" Margin="0,0,16,0" Padding="12,4"
                        Command="{Binding PurgeTaskCommand}"/>
                <TextBlock Text="恢复可离线操作；彻底删除需联网" Foreground="#666666"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F5F6F8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,6" Foreground="#555555"/>
        </Border>

        <DataGrid ItemsSource="{Binding DeletedTasks}" SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="状态" Width="80"
                                    Binding="{Binding Status, Converter={StaticResource StatusToText}}"/>
                <DataGridTextColumn Header="优先级" Width="80"
                                    Binding="{Binding Priority, Converter={StaticResource PriorityToText}}"/>
                <DataGridTextColumn Header="截止时间" Width="140"
                                    Binding="{Binding DueTime, Converter={StaticResource UtcToLocal}}"/>
                <DataGridTextColumn Header="更新时间" Width="140"
                                    Binding="{Binding UpdatedAt, Converter={StaticResource UtcToLocal}}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
